{
  "name": "health-insight",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@health/api & npm run dev --workspace=@health/web",
    "build": "npm run build --workspace=@health/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "db:up": "docker compose up -d",
    "db:migrate": "drizzle-kit migrate --config=apps/api/drizzle.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
