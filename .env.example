# --- apps/api/.env ---
LLM_PROVIDER=google            # google | anthropic | openai
LLM_API_KEY=                   # Google AI Studio key — aistudio.google.com/apikey
LLM_MODEL=gemini-3.8-flash
PORT=8787
WEB_ORIGIN=http://localhost:5173
RATE_LIMIT_PER_MIN=4           # chat turns per authenticated user

AUTH_MODE=sso                  # sso | demo — demo needs DEMO_ACCESS_CODE
AUTH_DEV_BYPASS=true           # non-production builds ONLY; ignored when NODE_ENV=production
DEV_USER_EMAIL=dev@localhost
# DEMO_ACCESS_CODE=            # required only when AUTH_MODE=demo; 32+ chars, boot fails if short

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/callback
SESSION_SECRET=
DATABASE_URL=postgres://health:health@localhost:5432/health
# DIRECT_DATABASE_URL=       # non-pooled URL used by migrations only; falls back to DATABASE_URL
